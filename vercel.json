{
  "rewrites": [
    {
      "source": "/release/:tx",
      "destination": "/verify.html"
    },
    {
      "source": "/release/:tx/(.*)",
      "destination": "/verify.html"
    },
    {
      "source": "/keys",
      "destination": "/keys.html"
    },
    {
      "source": "/keys/:fingerprint",
      "destination": "/keys.html"
    },
    {
      "source": "/spec",
      "destination": "/spec.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/c-017",
      "destination": "/c-017.html"
    },
    {
      "source": "/protocol",
      "destination": "/protocol.html"
    }
  ],
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site-public",
  "headers": [
    {
      "source": "/downloads/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
